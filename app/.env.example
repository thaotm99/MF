# Sao chép thành .env (đã nằm trong .gitignore — không commit).
# Bắt buộc khi public qua Cloudflare Tunnel: mật khẩu đăng nhập dashboard (nên ≥ 12 ký tự).
DASHBOARD_PASSWORD=
# Tên đăng nhập, mặc định admin
DASHBOARD_USER=admin
# Tên miền riêng (nếu dùng named tunnel), phân cách bằng dấu phẩy. *.trycloudflare.com đã được cho phép sẵn.
DASHBOARD_ALLOWED_HOSTS=

# Phân tích lệnh bằng Claude Code (tuỳ chọn): đường dẫn lệnh claude nếu không có trong PATH, model muốn dùng
# DASHBOARD_CLAUDE_BIN=claude
# DASHBOARD_CLAUDE_MODEL=
