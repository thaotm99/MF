# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Key Exness — không bao giờ commit
.env
.env.*
!.env.example

# Báo cáo MT5 (số tài khoản, lịch sử giao dịch) — không commit
reports/*
!reports/.gitkeep

# Nến xuất từ MT5 (CSV) — dữ liệu cục bộ, không commit
candles/*
!candles/.gitkeep

# Nhật ký nhãn / ghi chú từng lệnh — dữ liệu cá nhân, không commit
journal/*
!journal/.gitkeep

# Kết quả phân tích AI (Claude Code) — dữ liệu cá nhân, không commit
ai-analyses/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
